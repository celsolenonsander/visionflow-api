# ═══════════════════════════════════════════════════════════
# VisionFlow API — variáveis de ambiente
# Copie para .env e preencha com valores reais.
# .env NÃO é versionado (está no .gitignore).
# ═══════════════════════════════════════════════════════════

# ─── Servidor HTTP ───────────────────────────────────────────
PORT=8080

# ─── PostgreSQL ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=epare
DB_PASSWORD=trocar_pela_senha_real
DB_NAME=epare_forca_de_vendas

# Pool (opcional — usa defaults se omitir)
DB_POOL_MAX_CONNS=10
DB_POOL_MIN_CONNS=2
DB_POOL_MAX_CONN_LIFETIME=30m

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET=trocar_por_uma_string_longa_e_aleatoria
JWT_EXPIRATION=8h

# ─── CORS ────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000